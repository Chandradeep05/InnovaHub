# Backend Environment Variables
# Copy this file to .env and fill in the values

PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# JWT
JWT_SECRET=generate-a-strong-random-string-here

# Frontend URL (for CORS — set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Brevo Email API (free at https://brevo.com — 300 emails/day, no domain needed)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_NAME=Innovahub(IH)
BREVO_FROM_EMAIL=your-verified-email@gmail.com
